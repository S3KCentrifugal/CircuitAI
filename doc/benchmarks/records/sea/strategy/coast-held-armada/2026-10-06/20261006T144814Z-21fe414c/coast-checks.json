{
  "stop_minute": 14.0,
  "expect": [
    {
      "key": "control",
      "pattern": "CoastFixture.*held control complete",
      "by_minute": 14.0,
      "scope": "any"
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception|Error in.*sea_coast",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "CoastFixture.*FAIL",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "false-loss",
      "pattern": "SEA.*Coast.*fallback=true",
      "scope": "any"
    }
  ]
}
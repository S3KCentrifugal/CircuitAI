{
  "stop_minute": 30,
  "expect": [
    {
      "key": "observer",
      "pattern": "SeaRecoveryTest\\] loaded teams=16",
      "by_minute": 1,
      "scope": "any"
    },
    {
      "key": "sub-scaling",
      "pattern": "SeaRecoveryTest\\] PASS sub-scaling",
      "by_minute": 30,
      "scope": "any"
    }
  ],
  "forbid": [
    {
      "key": "errors",
      "pattern": "INVARIANT|SCRIPT CRASH|: ERR\\s+:|has crashed|Lib exception|SeaRecoveryTest\\] FAIL|Error in.*sea_recovery",
      "scope": "any"
    }
  ]
}

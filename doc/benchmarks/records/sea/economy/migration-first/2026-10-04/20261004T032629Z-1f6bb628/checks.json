{
  "stop_minute": 20,
  "expect": [{"key":"observer", "pattern":"\\[SeaWatch\\] loaded", "by_minute":1, "scope":"any"}],
  "forbid": [
    {"key":"script", "pattern":": ERR\\s+:|SCRIPT CRASH|Lib exception", "scope":"any"},
    {"key":"invariant", "pattern":"INVARIANT|Error in.*sea_watch", "scope":"any"},
    {"key":"crash", "pattern":"Access violation|has crashed|Fatal:", "scope":"any"}
  ]
}

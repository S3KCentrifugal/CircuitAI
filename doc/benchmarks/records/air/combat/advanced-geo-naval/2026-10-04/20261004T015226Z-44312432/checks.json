{
  "stop_minute": 10,
  "expect": [
    {
      "key": "loaded",
      "pattern": "event=loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "launch",
      "pattern": "event=launch",
      "scope": "any",
      "by_minute": 4
    },
    {
      "key": "airborne",
      "pattern": "event=flight.*autoland=0 landed=0",
      "scope": "any",
      "by_minute": 4
    },
    {
      "key": "screenshot",
      "pattern": "event=screenshot",
      "scope": "any",
      "by_minute": 4
    },
    {
      "key": "geo-primary",
      "pattern": "WAVE: strike target (?:armageo|corageo|legageo).*preference 5",
      "scope": "any",
      "by_minute": 10
    },
    {
      "key": "geo-destroyed",
      "pattern": "event=death.*attackerTeam=0.*team=1 unit=(?:armageo|corageo|legageo)",
      "scope": "any",
      "by_minute": 10
    },
    {
      "key": "naval-primary",
      "pattern": "WAVE: strike target (?:armuwmmm|coruwmmm|leganavaleconv).*preference 5",
      "scope": "any",
      "by_minute": 10
    },
    {
      "key": "naval-destroyed",
      "pattern": "event=death.*attackerTeam=0.*team=1 unit=(?:armuwmmm|coruwmmm|leganavaleconv)",
      "scope": "any",
      "by_minute": 10
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT|\\[AirOrders\\] ERROR",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "event=error|Removed widget: AIR combat arena|Failed to load: air_arena|Error in.*air_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ]
}
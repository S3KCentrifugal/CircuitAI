{
  "stop_minute": 8,
  "expect": [
    {
      "key": "loaded",
      "pattern": "event=loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "launch",
      "pattern": "event=launch",
      "scope": "any",
      "by_minute": 4
    },
    {
      "key": "airborne",
      "pattern": "event=flight.*autoland=0 landed=0",
      "scope": "any",
      "by_minute": 4
    },
    {
      "key": "screenshot",
      "pattern": "event=screenshot",
      "scope": "any",
      "by_minute": 4
    },
    {
      "key": "fusion-primary",
      "pattern": "WAVE: strike target (armfus|corfus|legfus|armckfus).*preference 5",
      "scope": "any",
      "by_minute": 7
    },
    {
      "key": "fusion-destroyed",
      "pattern": "event=death.*attackerTeam=0.*team=1 unit=(armfus|corfus|legfus|armckfus)",
      "scope": "any",
      "by_minute": 8
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT|\\[AirOrders\\] ERROR",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "event=error|Removed widget: AIR combat arena|Failed to load: air_arena|Error in.*air_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ]
}
{
  "stop_minute":10,
  "expect":[
    {"key":"loaded","pattern":"\\[AirArena\\] event=loaded","scope":"any","by_minute":1},
    {"key":"frontline-plan","pattern":"\\[AIR\\]\\[Waves\\] planned strike.*mission=frontline","scope":"any","by_minute":6},
    {"key":"bomber-hits-front","pattern":"\\[AirArena\\] event=damage.*adef=armpnix.*vdef=armguard","scope":"any","by_minute":10},
    {"key":"screenshot","pattern":"\\[AirArena\\] event=screenshot","scope":"any","by_minute":5}
  ],
  "forbid":[
    {"key":"script","pattern":": ERR\\s+:|SCRIPT CRASH|Lib exception","scope":"any"},
    {"key":"invariant","pattern":"INVARIANT|\\[AirOrders\\] ERROR","scope":"any"},
    {"key":"fixture","pattern":"\\[AirArena\\] event=error|Removed widget: AIR combat arena|Failed to load: air_arena|Error in.*air_arena","scope":"any"},
    {"key":"crash","pattern":"Access violation|has crashed|Fatal:","scope":"any"}
  ]
}

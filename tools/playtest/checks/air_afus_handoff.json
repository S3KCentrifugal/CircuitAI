{
  "stop_minute":6,
  "expect":[
    {"key":"loaded","pattern":"\\[AirArena\\] event=loaded","scope":"any","by_minute":1},
    {"key":"launch","pattern":"\\[AirArena\\] event=launch","scope":"any","by_minute":4},
    {"key":"visible","pattern":"event=priority_visible","scope":"any","by_minute":4},
    {"key":"attack","pattern":"event=priority_attack","scope":"any","by_minute":4},
    {"key":"damage","pattern":"event=damage.*adef=(legphoenix|armpnix|corhurc).*vdef=armafus","scope":"any","by_minute":5},
    {"key":"dead","pattern":"event=death.*attackerTeam=0.*unit=armafus","scope":"any","by_minute":6},
    {"key":"cleanup","pattern":"event=damage.*adef=(legphoenix|armpnix|corhurc).*vdef=armestor","scope":"any","by_minute":6},
    {"key":"screenshot","pattern":"event=screenshot.*priority-visible","scope":"any","by_minute":4}
  ],
  "forbid":[
    {"key":"script","pattern":": ERR\\s+:|SCRIPT CRASH|Lib exception","scope":"any"},
    {"key":"invariant","pattern":"INVARIANT|\\[AirOrders\\] ERROR","scope":"any"},
    {"key":"fixture","pattern":"event=error|Removed widget: AIR combat arena|Failed to load: air_arena|Error in.*air_arena","scope":"any"},
    {"key":"crash","pattern":"Access violation|has crashed|Fatal:","scope":"any"}
  ]
}

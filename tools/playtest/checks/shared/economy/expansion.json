{
  "stop_minute": 25,
  "expect": [
    {"key":"first-mex", "pattern":"\\[Team\\]\\[Roster\\] first mex", "scope":"any", "by_minute":5},
    {"key":"air-bank", "pattern":"\\[AIR\\]\\[Layout\\] cluster=1 labs=6", "by_minute":6},
    {"key":"converters", "pattern":"t1-converters=[1-9]", "scope":"any", "by_minute":15},
    {"key":"tech-future", "pattern":"\\[TECH\\]\\[Expansion\\] held .*gantry|\\[TECH\\]\\[Expansion\\] held (armshltx|corgant|leggant)", "scope":"any", "by_minute":5},
    {"key":"wall", "pattern":"\\[ExpansionWatch\\] wall-finished", "scope":"any", "by_minute":15},
    {"key":"mex-drop", "pattern":"anchor=first-mex", "scope":"any", "by_minute":25},
    {"key":"nearby-gift", "pattern":"constructor-gift team=0 .*mex-distance=[0-9]{1,3}(?:\\s|$)", "scope":"any", "by_minute":15}
  ],
  "forbid": [
    {"key":"script", "pattern":": ERR\\s+:|SCRIPT CRASH|Lib exception", "scope":"any"},
    {"key":"invariant", "pattern":"INVARIANT", "scope":"any"},
    {"key":"crash", "pattern":"Access violation|has crashed|Fatal:", "scope":"any"},
    {"key":"observer", "pattern":"Removed widget: Expansion|Error in.*expansion_watch", "scope":"any"}
  ]
}

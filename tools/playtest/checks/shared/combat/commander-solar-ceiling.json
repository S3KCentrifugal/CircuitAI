{
  "stop_minute": 3,
  "expect": [
    {
      "key": "actual high-income stall",
      "pattern": "high income stall observed",
      "scope": "any",
      "by_minute": 2
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "new regular solar",
      "pattern": "work=22 solar=|child id=\\d+ parent=\\d+ unit=armsolar",
      "scope": "any"
    }
  ]
}

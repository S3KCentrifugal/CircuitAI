      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "physical retreat",
      "pattern": "health_fixture_withdrew",
      "scope": "any",
      "by_minute": 1
    }
  ],
  "forbid": [
    {
      "key": "errors",
      "pattern": "\\[INVARIANT\\]|\\[RangedArena\\].*ERROR|SCRIPT CRASH|Lib exception|Access violation|has crashed|: ERR\\s+:",
      "scope": "any"
    }
  ]
}

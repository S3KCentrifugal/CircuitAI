{
  "stop_minute": 8,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "fill on",
      "pattern": "\\[FrontLayout\\] fill on",
      "scope": "any",
      "by_minute": 4
    },
    {
      "key": "fill job",
      "pattern": "\\[FrontLayout\\] fill builder=\\d+ tier=1 slot=\\d+",
      "scope": "any",
      "by_minute": 5,
      "after_key": "fill on"
    },
    {
      "key": "second fill job",
      "pattern": "\\[FrontLayout\\] fill builder=\\d+ tier=1 slot=\\d+ .* jobs=2",
      "scope": "any",
      "by_minute": 6,
      "after_key": "fill on"
    },
    {
      "key": "turret finished",
      "pattern": "\\[RangedArena\\].*finished id=\\d+ team=0 unit=armnanotc",
      "scope": "any",
      "by_minute": 8
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\] INV-(?!254 )",
      "scope": "any",
      "note": "INV-254 (the commander waiting on a seat-only defence) fires on the pre-branch build in commander-group-t2-defence as well: KI-757."
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ]
}
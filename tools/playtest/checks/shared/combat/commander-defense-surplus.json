{
  "stop_minute": 6,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "rules",
      "pattern": "\\[DefenseFixture\\] applied",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "surplus",
      "pattern": "\\[DefensePlanner\\] choice=armpb band=0 .*surplus=1",
      "scope": "any",
      "by_minute": 4
    },
    {
      "key": "finished",
      "pattern": "\\[Playtest\\] finished armpb team 0",
      "scope": "any",
      "by_minute": 6,
      "after_key": "surplus"
    },
    {
      "key": "nano",
      "pattern": "\\[CommanderGroup\\] job_start def=armnanotc nano=1",
      "scope": "any",
      "by_minute": 6,
      "after_key": "finished"
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "rule rejected",
      "pattern": "\\[DefenseFixture\\] ERROR",
      "scope": "any"
    }
  ],
  "complete_on": {
    "key": "nano",
    "pattern": "\\[CommanderGroup\\] job_start def=armnanotc nano=1",
    "scope": "any"
  },
  "completion_grace_seconds": 10
}

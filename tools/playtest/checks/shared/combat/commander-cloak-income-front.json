{
  "stop_minute": 2,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].*loaded",
      "scope": "any",
      "by_minute": 0.5
    },
    {
      "key": "economy cloak selected",
      "pattern": "\\[CommanderPosture\\].*cloak=1 reason=front economy cloak",
      "scope": "any",
      "by_minute": 1.1
    },
    {
      "key": "actual cloak",
      "pattern": "unit id=\\d+ unit=armcom .*cloak=true",
      "scope": "any",
      "after_minute": 0.8,
      "by_minute": 1.15
    },
    {
      "key": "retained after generators removed",
      "pattern": "unit id=\\d+ unit=armcom .*cloak=true",
      "scope": "any",
      "after_minute": 1.6,
      "by_minute": 2
    },
    {
      "key": "generators removed",
      "pattern": "fixture_units_removed unit=armfus count=3",
      "scope": "any",
      "by_minute": 1.4
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "peaceful energy retreat",
      "pattern": "cloak_energy_retreat",
      "scope": "any"
    },
    {
      "key": "cloak flapping",
      "pattern": "\\[CommanderCloak\\] unit=\\d+ minute=\\d+ .*toggles=([6-9]|\\d\\d)",
      "scope": "any"
    }
  ]
}

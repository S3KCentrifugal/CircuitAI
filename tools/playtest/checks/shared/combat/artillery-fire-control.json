{
  "stop_minute": 5,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "guns",
      "pattern": "\\[RangedArena\\].*spawn id=\\d+ team=0 unit=armamb",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "aim support",
      "pattern": "\\[Artillery\\] aim unit=\\d+ target=\\d+ def=cornanotc kind=support .*preset=artillery_popup",
      "scope": "any",
      "by_minute": 4,
      "after_key": "guns"
    },
    {
      "key": "aim static",
      "pattern": "\\[Artillery\\] aim unit=\\d+ target=\\d+ def=corpun kind=static",
      "scope": "any",
      "by_minute": 5,
      "after_key": "aim support"
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\] INV-(?!254 )",
      "scope": "any",
      "note": "INV-254 (the commander waiting on a seat-only defence) is KI-757."
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ]
}
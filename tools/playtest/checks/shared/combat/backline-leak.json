{
  "stop_minute": 4,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "lease",
      "pattern": "RANGED: assigned corstorm",
      "scope": "any",
      "by_minute": 2
    },
    {
      "key": "station",
      "pattern": "BACKLINE: station unit=\\d+ screen=\\d+",
      "scope": "any",
      "by_minute": 3
    },
    {
      "key": "tuck",
      "pattern": "BACKLINE: tuck unit=\\d+ threat=\\d+",
      "scope": "any",
      "by_minute": 4
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT",
      "scope": "any"
    },
    {
      "key": "config",
      "pattern": "CONFIG controllers: preset|CONFIG formations: template",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena|Removed widget: Ranged combat arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ]
}

      "key": "nearby_healed",
      "by_minute": 7
    },
    {
      "pattern": "\\[MaintenanceProbe\\] PASS construction_started",
      "scope": "any",
      "key": "construction_started",
      "by_minute": 7
    },
    {
      "pattern": "\\[MaintenanceProbe\\] PASS build_retained_on_ask",
      "scope": "any",
      "key": "build_retained_on_ask",
      "by_minute": 7
    },
    {
      "pattern": "\\[MaintenanceProbe\\] PASS assist_retained_on_ask",
      "scope": "any",

{
  "stop_minute": 2,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "brawl",
      "pattern": "\\[CommanderPosture\\] unit=\\d+ posture=brawl cloak=0 .*dps=[1-9]\\d*",
      "scope": "any",
      "by_minute": 1.2
    },
    {
      "key": "shot",
      "pattern": "\\[Commander\\].*shot_confirmed",
      "scope": "any",
      "by_minute": 1.5
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "posture cloak",
      "pattern": "\\[CommanderPosture\\].* cloak=1 ",
      "scope": "any"
    },
    {
      "key": "cloak flapping",
      "pattern": "\\[CommanderCloak\\] unit=\\d+ minute=\\d+ .*toggles=([6-9]|\\d\\d)",
      "scope": "any"
    }
  ]
}

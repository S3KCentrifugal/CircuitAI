{
  "stop_minute": 6,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "spawn",
      "pattern": "\\[RangedArena\\].* spawn",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "lease",
      "pattern": "RANGED: assigned corstorm",
      "scope": "any",
      "by_minute": 2
    },
    {
      "key": "group",
      "pattern": "GROUP: group=\\d+ order=",
      "scope": "any",
      "by_minute": 3
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT",
      "scope": "any"
    },
    {
      "key": "config",
      "pattern": "CONFIG controllers: preset|CONFIG formations: template",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena|Removed widget: Ranged combat arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ],
  "complete_on": {
    "key": "cleared",
    "pattern": "\\[RangedArena\\].* enemy_statics_cleared",
    "scope": "any"
  },
  "completion_grace_seconds": 3
}

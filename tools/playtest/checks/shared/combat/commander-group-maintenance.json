{
  "stop_minute": 4,
  "expect": [
    {
      "key": "loaded",
      "pattern": "\\[RangedArena\\].* loaded",
      "scope": "any",
      "by_minute": 1
    },
    {
      "key": "front T2",
      "pattern": "\\[CommanderGroup\\] admitted seat=0 unit=\\d+",
      "scope": "any",
      "by_minute": 2
    },
    {
      "key": "defense completed",
      "pattern": "\\[CommanderGroup\\] job_end done=1 nano=0",
      "scope": "any",
      "by_minute": 3
    },
    {
      "key": "following nano",
      "pattern": "\\[CommanderGroup\\] job_start def=armnanotc nano=1",
      "scope": "any",
      "by_minute": 4,
      "after_key": "defense completed"
    },
    {
      "key": "nano completed",
      "pattern": "\\[CommanderGroup\\] job_end done=1 nano=1",
      "scope": "any",
      "by_minute": 3,
      "after_key": "following nano"
    },
    {
      "key": "radar finished",
      "pattern": "\\[RangedArena\\].*finished id=\\d+ team=0 unit=armarad",
      "scope": "any",
      "by_minute": 3
    },
    {
      "key": "nearby radar fixture",
      "pattern": "\\[RangedArena\\].*spawn id=\\d+ team=0 unit=armrad ",
      "scope": "any",
      "by_minute": 1.5
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "\\[INVARIANT\\]",
      "scope": "any"
    },
    {
      "key": "fixture",
      "pattern": "\\[RangedArena\\].*ERROR|Error in.*ranged_arena",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    }
  ]
}

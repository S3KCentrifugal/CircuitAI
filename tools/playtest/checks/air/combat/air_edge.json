{
  "stop_minute":10,
  "expect":[
    {"key":"loaded","pattern":"\\[AirArena\\] event=loaded","scope":"any","by_minute":1},
    {"key":"launch","pattern":"\\[AirArena\\] event=launch","scope":"any","by_minute":4},
    {"key":"edge-plan","pattern":"WAVE: mission .*route=edge","scope":"any","by_minute":4},
    {"key":"flank-flown","pattern":"event=route_crossing.*flank=1","scope":"any","by_minute":6},
    {"key":"target-damage","pattern":"event=damage.*adef=(armpnix|corhurc|legphoenix).*vdef=(armafus|armmmkr)","scope":"any","by_minute":8},
    {"key":"afus-dead","pattern":"event=death.*attackerTeam=0.*unit=armafus","scope":"any","by_minute":10},
    {"key":"flank-screenshot","pattern":"event=screenshot.*flank-crossing","scope":"any","by_minute":6}
  ],
  "forbid":[
    {"key":"script","pattern":": ERR\\s+:|SCRIPT CRASH|Lib exception","scope":"any"},
    {"key":"invariant","pattern":"INVARIANT|\\[AirOrders\\] ERROR","scope":"any"},
    {"key":"fixture","pattern":"event=error|Removed widget: AIR combat arena|Error in.*air_arena","scope":"any"},
    {"key":"crash","pattern":"Access violation|has crashed|Fatal:","scope":"any"}
  ]
}

{
  "stop_minute": 12,
  "expect": [
    {
      "key": "mobile-t1",
      "pattern": "construction t1=(8|9|10)",
      "scope": "any",
      "by_minute": 12
    },
    {
      "key": "mobile-t2",
      "pattern": "construction t1=\\d+ t2=[6-8]",
      "scope": "any",
      "by_minute": 12
    },
    {
      "key": "static",
      "pattern": "\\[AirWatch\\] construction .*nanos=([2-9][0-9]|[1-9][0-9][0-9])",
      "scope": "any",
      "by_minute": 12
    }
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "observer",
      "pattern": "Removed widget: AIR economy and attack observer|Error in.*air_watch",
      "scope": "any"
    }
  ]
}

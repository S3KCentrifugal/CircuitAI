{
  "stop_minute": 12,
  "expect": [
    {
      "key": "mobile-t1",
      "pattern": "construction t1=(?:[8-9]|[1-9][0-9]+)(?:\\s|$)",
      "scope": "any",
      "by_minute": 12
    },
    {
      "key": "mobile-t2",
      "pattern": "construction t1=\\d+ t2=(?:[6-9]|[1-9][0-9]+)(?:\\s|$)",
      "scope": "any",
      "by_minute": 12
    },
    {
      "key": "static",
      "pattern": "\\[AirWatch\\] construction .*nanos=(?:[2-9][0-9]|[1-9][0-9]{2,})(?:\\s|$)",
      "scope": "any",
      "by_minute": 12
    },
    {"key":"completed-worker", "pattern":"\\[AirWatch\\] finished id=\\d+ def=(?:arm|cor|leg)(?:aca|ca)(?:\\s|$)", "scope":"any", "by_minute":12},
    {"key":"working", "pattern":"\\[AirWatch\\] construction .*working=[1-9][0-9]*(?:\\s|$)", "scope":"any", "by_minute":12}
  ],
  "forbid": [
    {
      "key": "script",
      "pattern": ": ERR\\s+:|SCRIPT CRASH|Lib exception",
      "scope": "any"
    },
    {
      "key": "invariant",
      "pattern": "INVARIANT",
      "scope": "any"
    },
    {
      "key": "crash",
      "pattern": "Access violation|has crashed|Fatal:",
      "scope": "any"
    },
    {
      "key": "observer",
      "pattern": "Removed widget: AIR economy and attack observer|Error in.*air_watch",
      "scope": "any"
    }
  ]
}

{
  "stop_minute": 12,
  "expect": [
    {"key":"scout", "pattern":"\\[AirOpening\\] scout-finished", "scope":"any", "by_minute":6},
    {"key":"scouting", "pattern":"\\[AirOpening\\] scout-away", "scope":"any", "by_minute":7},
    {"key":"crew", "pattern":"\\[AirOpening\\] crew-ready", "scope":"any", "by_minute":8},
    {"key":"guard", "pattern":"\\[AIR\\]\\[Rule\\] opening.commander.guard", "by_minute":6},
    {"key":"fighter", "pattern":"\\[AirOpening\\] first-fighter", "scope":"any", "by_minute":10},
    {"key":"patrol", "pattern":"\\[AirOpening\\] screen fighters=\\d+ patrol=[1-9]", "scope":"any", "by_minute":12}
  ],
  "forbid": [
    {"key":"script", "pattern":": ERR\\s+:|SCRIPT CRASH|Lib exception", "scope":"any"},
    {"key":"invariant", "pattern":"INVARIANT", "scope":"any"},
    {"key":"crash", "pattern":"Access violation|has crashed|Fatal:", "scope":"any"},
    {"key":"observer", "pattern":"Removed widget: AIR opening|Error in.*air_opening_watch", "scope":"any"}
  ]
}
